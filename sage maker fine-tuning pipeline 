# 3. MODEL EVALUATION
# ════════════════════════════════════════════════════════════════

class ModelEvaluator:
    """
    Evaluates model performance on validation set
    """
    
    def __init__(self, endpoint_name: str, session: sagemaker.Session = None):
        self.endpoint_name = endpoint_name
        self.session = session or sagemaker_session
        self.predictor = Predictor(
            endpoint_name=endpoint_name,
            sagemaker_session=self.session
        )
    
    def evaluate_on_dataset(self, val_examples: List[Dict]) -> Dict:
        """
        Evaluate model on validation dataset
        
        Args:
            val_examples: Validation examples
        
        Returns:
            Evaluation metrics
        """
        
        logger.info(f"📊 Evaluating model on {len(val_examples)} examples...")
        
        correct_predictions = 0
        total_predictions = 0
        average_latency = 0
        
        for example in val_examples:
            try:
                start_time = datetime.utcnow()
                
                # Get prediction
                response = self.predictor.predict(json.dumps(example['input']))
                prediction = json.loads(response)
                
                latency = (datetime.utcnow() - start_time).total_seconds()
                average_latency += latency
                
                # Simple evaluation: check if output contains key phrases from expected
                if self._contains_key_phrases(prediction, example['output']):
                    correct_predictions += 1
                
                total_predictions += 1
            
            except Exception as e:
                logger.warning(f"⚠️ Evaluation error: {str(e)}")
        
        accuracy = (correct_predictions / total_predictions) if total_predictions > 0 else 0
        avg_latency = average_latency / total_predictions if total_predictions > 0 else 0
        
        metrics = {
            'accuracy': accuracy,
            'total_predictions': total_predictions,
            'correct_predictions': correct_predictions,
            'average_latency_seconds': avg_latency,
            'timestamp': datetime.utcnow().isoformat()
        }
        
        logger.info(f"✅ Evaluation complete:")
        logger.info(f"   Accuracy: {accuracy:.2%}")
        logger.info(f"   Latency: {avg_latency:.2f}s")
        
        return metrics
    
    def _contains_key_phrases(self, prediction: Dict, expected: str) -> bool:
        """Check if prediction contains key phrases from expected output"""
        
        predicted_text = prediction.get('output', '').lower()
        
        # Extract key words from expected (words > 4 chars)
        key_words = [w for w in expected.lower().split() if len(w) > 4]
        
        # Check if any key words are in prediction
        matches = sum(1 for w in key_words if w in predicted_text)
        
        return matches >= max(1, len(key_words) // 2)

