class BedrockMentorshipAgent:
    """
    Orchestrates Bedrock API calls for mentorship generation
    Uses Claude 3 with advanced reasoning
    """
    
    def __init__(self):
        self.model_id = CONFIG['BEDROCK_MODEL_ID']
        self.max_tokens = CONFIG['MAX_TOKENS']
        self.temperature = CONFIG['TEMPERATURE']
    
    def build_mentor_prompt(
        self,
        user_context: Dict,
        sauti_output: str,
        local_resources: List[Dict],
        language: str = 'sw'
    ) -> str:
        """
        Build comprehensive mentor prompt with context
        
        Args:
            user_context: User profile and history
            sauti_output: Original Sauti legal/civic response
            local_resources: Relevant local opportunities
            language: Target language (sw/en/sheng)
        
        Returns:
            Formatted prompt for Bedrock
        """
        
        persona = user_context.get('persona', 'farmer')
        persona_info = PERSONAS.get(persona, PERSONAS['farmer'])
        
        resources_text = "\n".join([
            f"- {r.get('name', 'Resource')}: {r.get('description', '')} (Contact: {r.get('contact', 'N/A')})"
            for r in local_resources[:3]
        ])
        
        language_instruction = {
            'sw': 'Respond in Swahili. Use simple, culturally relevant language.',
            'en': 'Respond in English. Use clear, actionable language.',
            'sheng': 'Respond in Sheng (Nairobi street language). Keep it real and relatable.'
        }
        
        prompt = f"""
        You are AI Mshauri, a trusted local mentor for economic empowerment and civic rights.
        
        USER CONTEXT:
        - Persona: {persona_info['profile']}
        - Location: {user_context.get('county', 'Unknown')}
        - Language: {language}
        - Recent Interaction: {user_context.get('last_topic', 'N/A')}
        
        WHAT THEY LEARNED FROM SAUTI:
        {sauti_output}
        
        YOUR ROLE:
        1. Acknowledge their concern with empathy
        2. Provide 1-2 specific next-step actions
        3. Connect them to verified local resources or opportunities
        4. End with an encouraging, actionable call-to-action
        
        LOCAL RESOURCES AVAILABLE:
        {resources_text if resources_text else 'No specific local resources found yet.'}
        
        TONE: {persona_info['tone']}
        {language_instruction.get(language, language_instruction['sw'])}
        
        CONSTRAINTS:
        - Maximum 3 sentences
        - Include 1 specific resource or action
        - Be practical and immediately actionable
        - Use local context (county names, real organizations)
        
        Generate mentorship response now:
        """
        
        return prompt
    
    def generate_mentorship(
        self,
        user_context: Dict,
        sauti_output: str,
        local_resources: List[Dict],
        language: str = 'sw'
    ) -> str:
        """
        Generate mentorship response using Bedrock Claude
        
        Args:
            user_context: User profile
            sauti_output: Civic/legal information from Sauti
            local_resources: Contextual local data
            language: Target language
        
        Returns:
            Mentorship response text
        """
        try:
            prompt = self.build_mentor_prompt(
                user_context,
                sauti_output,
                local_resources,
                language
            )
            
            logger.info("🧠 Calling Bedrock Claude for mentorship generation...")
            
            response = bedrock_client.invoke_model(
                modelId=self.model_id,
                contentType='application/json',
                accept='application/json',
                body=json.dumps({
                    'anthropic_version': 'bedrock-2023-06-01',
                    'max_tokens': self.max_tokens,
                    'temperature': self.temperature,
                    'messages': [
                        {
                            'role': 'user',
                            'content': prompt
                        }
                    ]
                })
            )
            
            # Parse Bedrock response
            response_body = json.loads(response['body'].read())
            mentorship_text = response_body['content'][0]['text']
            
            logger.info(f"✅ Mentorship generated: {mentorship_text[:100]}...")
            
            return mentorship_text
        
        except Exception as e:
            logger.error(f"❌ Error generating mentorship: {str(e)}")
            return "Samahani, tatizo linatokea. Jaribu tena baadaye. (Sorry, please try again later.)"

