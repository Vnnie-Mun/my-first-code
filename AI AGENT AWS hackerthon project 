class FeedbackAnalytics:
    """
    Collects feedback and stores for SageMaker retraining
    """
    
    def __init__(self):
        self.s3_bucket = CONFIG['S3_FEEDBACK_BUCKET']
        self.cloudwatch_client = cloudwatch
    
    def log_interaction(
        self,
        user_id: str,
        input_data: Dict,
        output_data: Dict,
        feedback: Optional[str] = None
    ) -> bool:
        """
        Log interaction for future model training
        
        Args:
            user_id: User identifier
            input_data: Input context
            output_data: Generated response
            feedback: User feedback (optional)
        
        Returns:
            Success boolean
        """
        try:
            record = {
                'timestamp': datetime.utcnow().isoformat(),
                'user_id': user_id,
                'input': input_data,
                'output': output_data,
                'feedback': feedback,
                'interaction_id': str(uuid.uuid4())
            }
            
            # Save to S3 for batch processing
            key = f"interactions/{datetime.utcnow().strftime('%Y/%m/%d')}/{user_id}_{uuid.uuid4()}.json"
            s3_client.put_object(
                Bucket=self.s3_bucket,
                Key=key,
                Body=json.dumps(record)
            )
            
            logger.info(f"✅ Interaction logged to S3: {key}")
            
            # Log metric to CloudWatch
            self._send_metric('InteractionLogged', 1)
            
            return True
        
        except Exception as e:
            logger.error(f"❌ Error logging interaction: {str(e)}")
            return False
    
    def _send_metric(self, metric_name: str, value: float):
        """Send metric to CloudWatch"""
        try:
            self.cloudwatch_client.put_metric_data(
                Namespace='AIMshauri',
                MetricData=[
                    {
                        'MetricName': metric_name,
                        'Value': value,
                        'Unit': 'Count',
                        'Timestamp': datetime.utcnow()
                    }
                ]
            )
        except Exception as e:
            logger.error(f"❌ Error sending metric: {str(e)}")

