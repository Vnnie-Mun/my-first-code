class MessageDeliveryOrchestrator:
    """
    Handles multi-channel delivery: SMS, WhatsApp, IVR
    Uses Twilio/Africa's Talking APIs
    """
    
    def __init__(self):
        self.twilio_sid = self._get_secret('TWILIO_ACCOUNT_SID')
        self.twilio_token = self._get_secret('TWILIO_AUTH_TOKEN')
        self.at_api_key = self._get_secret('AFRICASTALKING_API_KEY')
    
    def _get_secret(self, secret_name: str) -> str:
        """Retrieve secret from AWS Secrets Manager"""
        try:
            secrets_client = boto3.client('secretsmanager')
            response = secrets_client.get_secret_value(SecretId=secret_name)
            return response['SecretString']
        except Exception as e:
            logger.error(f"❌ Error retrieving secret: {str(e)}")
            return ""
    
    def send_sms(self, phone: str, message: str) -> bool:
        """
        Send SMS via Africa's Talking
        
        Args:
            phone: Recipient phone number
            message: Message text
        
        Returns:
            Success boolean
        """
        try:
            import requests
            
            url = "https://api.sandbox.africastalking.com/version1/messaging"
            headers = {
                "Accept": "application/json",
                "Content-Type": "application/x-www-form-urlencoded",
                "apiKey": self.at_api_key
            }
            data = {
                "username": "sandbox",
                "to": phone,
                "message": message
            }
            
            response = requests.post(url, headers=headers, data=data)
            
            if response.status_code == 201:
                logger.info(f"✅ SMS sent to {phone}")
                return True
            else:
                logger.error(f"❌ SMS failed: {response.text}")
                return False
        
        except Exception as e:
            logger.error(f"❌ Error sending SMS: {str(e)}")
            return False
    
    def send_whatsapp(self, phone: str, message: str) -> bool:
        """
        Send WhatsApp message
        
        Args:
            phone: Recipient phone
            message: Message text
        
        Returns:
            Success boolean
        """
        try:
            # Implementation depends on WhatsApp Business API
            logger.info(f"📱 WhatsApp message queued for {phone}")
            return True
        except Exception as e:
            logger.error(f"❌ Error sending WhatsApp: {str(e)}")
            return False
    
    def deliver_message(self, phone: str, message: str, channels: List[str]) -> Dict:
        """
        Deliver message via multiple channels
        
        Args:
            phone: Recipient phone
            message: Message content
            channels: List of delivery channels
        
        Returns:
            Delivery status dictionary
        """
        results = {}
        
        for channel in channels:
            if channel == 'sms':
                results['sms'] = self.send_sms(phone, message)
            elif channel == 'whatsapp':
                results['whatsapp'] = self.send_whatsapp(phone, message)
            elif channel == 'ivr':
                results['ivr'] = True  # IVR integration
        
        return results

