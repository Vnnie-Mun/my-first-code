class MshuariModelFinetuner:
    """
    Fine-tunes language models on Mshauri domain data
    """
    
    def __init__(self, role_arn: str, session: sagemaker.Session = None):
        self.role_arn = role_arn
        self.session = session or sagemaker_session
        self.region = self.session.boto_region_name
    
    def finetune_model(
        self,
        train_data_s3: str,
        val_data_s3: str,
        model_name: str = 'mshauri-mentor-model',
        instance_count: int = 1,
        instance_type: str = 'ml.g4dn.xlarge'
    ) -> str:
        """
        Fine-tune a language model on Mshauri data
        
        Args:
            train_data_s3: S3 path to training data
            val_data_s3: S3 path to validation data
            model_name: Name for the fine-tuned model
            instance_count: Number of training instances
            instance_type: Instance type for training
        
        Returns:
            Model artifact S3 path
        """
        
        logger.info(f"🧠 Fine-tuning model: {model_name}")
        
        # Training job configuration
        job_name = f"mshauri-finetuning-{datetime.utcnow().strftime('%Y%m%d%H%M%S')}"
        
        hyperparameters = {
            'epochs': 3,
            'batch_size': 8,
            'learning_rate': 1e-4,
            'warmup_ratio': 0.1,
            'weight_decay': 0.01,
            'max_seq_length': 512,
            'fp16': True
        }
        
        # Create HuggingFace estimator
        huggingface_estimator = Estimator(
            image_uri=self._get_huggingface_image_uri(),
            role=self.role_arn,
            instance_count=instance_count,
            instance_type=instance_type,
            output_path=f"s3://{sagemaker_session.default_bucket()}/mshauri-models",
            hyperparameters=hyperparameters,
            sagemaker_session=self.session
        )
        
        # Set input channels
        train_input = sagemaker.inputs.TrainingInput(
            s3_data=train_data_s3,
            content_type='application/x-recordio-protobuf'
        )
        val_input = sagemaker.inputs.TrainingInput(
            s3_data=val_data_s3,
            content_type='application/x-recordio-protobuf'
        )
        
        # Start training
        logger.info(f"🚀 Starting training job: {job_name}")
        huggingface_estimator.fit(
            {'train': train_input, 'validation': val_input},
            job_name=job_name,
            wait=True
        )
        
        # Get model artifact
        model_artifact_s3 = huggingface_estimator.model_data
        logger.info(f"✅ Model training complete: {model_artifact_s3}")
        
        return model_artifact_s3
    
    def _get_huggingface_image_uri(self) -> str:
        """Get HuggingFace training image URI for region"""
        
        image_uris = {
            'us-east-1': '763104330519.dkr.ecr.us-east-1.amazonaws.com/huggingface-pytorch-training:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04',
            'us-west-2': '246618743249.dkr.ecr.us-west-2.amazonaws.com/huggingface-pytorch-training:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04',
            'eu-west-1': '685385470294.dkr.ecr.eu-west-1.amazonaws.com/huggingface-pytorch-training:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04'
        }
        
        return image_uris.get(self.region, image_uris['us-east-1'])
    
    def deploy_model(
        self,
        model_artifact_s3: str,
        model_name: str = 'mshauri-mentor-endpoint',
        instance_type: str = 'ml.g4dn.xlarge'
    ) -> str:
        """
        Deploy fine-tuned model to SageMaker endpoint
        
        Args:
            model_artifact_s3: S3 path to model artifact
            model_name: Name for the endpoint
            instance_type: Instance type for hosting
        
        Returns:
            Endpoint name
        """
        
        logger.info(f"🚀 Deploying model to endpoint: {model_name}")
        
        # Create model
        model = Model(
            image_uri=self._get_inference_image_uri(),
            model_data=model_artifact_s3,
            role=self.role_arn,
            sagemaker_session=self.session
        )
        
        # Deploy to endpoint
        endpoint_name = f"mshauri-{datetime.utcnow().strftime('%Y%m%d%H%M%S')}"
        
        model.deploy(
            initial_instance_count=1,
            instance_type=instance_type,
            endpoint_name=endpoint_name,
            wait=True
        )
        
        logger.info(f"✅ Model deployed to endpoint: {endpoint_name}")
        
        return endpoint_name
    
    def _get_inference_image_uri(self) -> str:
        """Get HuggingFace inference image URI"""
        
        image_uris = {
            'us-east-1': '763104330519.dkr.ecr.us-east-1.amazonaws.com/huggingface-pytorch-inference:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04',
            'us-west-2': '246618743249.dkr.ecr.us-west-2.amazonaws.com/huggingface-pytorch-inference:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04',
            'eu-west-1': '685385470294.dkr.ecr.eu-west-1.amazonaws.com/huggingface-pytorch-inference:2.1.0-transformers4.34.1-gpu-py310-cu118-ubuntu20.04'
        }
        
        return image_uris.get(self.region, image_uris['us-east-1'])

