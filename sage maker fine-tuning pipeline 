class MshuariDataCollector:
    """
    Collects interaction data from S3 and prepares for training
    """
    
    def __init__(self, s3_bucket: str):
        self.s3_bucket = s3_bucket
        self.s3_client = s3_client
    
    def collect_interactions(self, days_back: int = 30) -> pd.DataFrame:
        """
        Collect all user interactions from S3 feedback lake
        
        Args:
            days_back: Number of days to look back
        
        Returns:
            DataFrame with interactions
        """
        
        logger.info(f"📊 Collecting interactions from last {days_back} days...")
        
        interactions = []
        prefix = "interactions/"
        
        # List all objects in S3
        paginator = self.s3_client.get_paginator('list_objects_v2')
        pages = paginator.paginate(Bucket=self.s3_bucket, Prefix=prefix)
        
        count = 0
        for page in pages:
            for obj in page.get('Contents', []):
                try:
                    # Download and parse interaction JSON
                    response = self.s3_client.get_object(
                        Bucket=self.s3_bucket,
                        Key=obj['Key']
                    )
                    
                    data = json.loads(response['Body'].read())
                    interactions.append(data)
                    count += 1
                
                except Exception as e:
                    logger.warning(f"⚠️ Error parsing {obj['Key']}: {str(e)}")
        
        df = pd.DataFrame(interactions)
        logger.info(f"✅ Collected {count} interactions")
        
        return df
    
    def prepare_training_dataset(
        self,
        interactions_df: pd.DataFrame
    ) -> Tuple[List[Dict], List[Dict]]:
        """
        Prepare training and validation datasets
        
        Args:
            interactions_df: Raw interactions data
        
        Returns:
            Tuple of (training_examples, validation_examples)
        """
        
        logger.info("🔄 Preparing training dataset...")
        
        training_examples = []
        
        for _, row in interactions_df.iterrows():
            try:
                example = {
                    'input': {
                        'sauti_output': row['input'].get('sauti_output', ''),
                        'category': row['input'].get('category', ''),
                        'county': row['input'].get('county', ''),
                        'persona': row.get('persona', 'farmer'),
                        'language': row.get('language', 'sw')
                    },
                    'output': row['output'].get('mentorship_response', ''),
                    'feedback': row.get('feedback', ''),
                    'timestamp': row.get('timestamp', datetime.utcnow().isoformat())
                }
                
                # Filter out low-quality examples
                if self._is_valid_example(example):
                    training_examples.append(example)
            
            except Exception as e:
                logger.warning(f"⚠️ Skipping invalid example: {str(e)}")
        
        # Split into training and validation
        split_idx = int(len(training_examples) * 0.8)
        train_set = training_examples[:split_idx]
        val_set = training_examples[split_idx:]
        
        logger.info(f"✅ Prepared {len(train_set)} training + {len(val_set)} validation examples")
        
        return train_set, val_set
    
    def _is_valid_example(self, example: Dict) -> bool:
        """Validate training example quality"""
        
        # Check required fields
        if not example['input'].get('sauti_output'):
            return False
        if not example['output']:
            return False
        
        # Check minimum lengths
        if len(example['input']['sauti_output']) < 20:
            return False
        if len(example['output']) < 30:
            return False
        
        return True
    
    def save_training_dataset(
        self,
        train_examples: List[Dict],
        val_examples: List[Dict],
        output_prefix: str = 'training-datasets'
    ) -> Tuple[str, str]:
        """
        Save training and validation datasets to S3
        
        Args:
            train_examples: Training examples
            val_examples: Validation examples
            output_prefix: S3 prefix for output
        
        Returns:
            Tuple of (train_s3_path, val_s3_path)
        """
        
        logger.info("💾 Saving datasets to S3...")
        
        timestamp = datetime.utcnow().strftime('%Y%m%d_%H%M%S')
        
        # Save training data
        train_key = f"{output_prefix}/train_{timestamp}.jsonl"
        with open('/tmp/train.jsonl', 'w') as f:
            for example in train_examples:
                f.write(json.dumps(example) + '\n')
        
        self.s3_client.upload_file(
            '/tmp/train.jsonl',
            self.s3_bucket,
            train_key
        )
        
        # Save validation data
        val_key = f"{output_prefix}/val_{timestamp}.jsonl"
        with open('/tmp/val.jsonl', 'w') as f:
            for example in val_examples:
                f.write(json.dumps(example) + '\n')
        
        self.s3_client.upload_file(
            '/tmp/val.jsonl',
            self.s3_bucket,
            val_key
        )
        
        train_s3_path = f"s3://{self.s3_bucket}/{train_key}"
        val_s3_path = f"s3://{self.s3_bucket}/{val_key}"
        
        logger.info(f"✅ Training data: {train_s3_path}")
        logger.info(f"✅ Validation data: {val_s3_path}")
        
        return train_s3_path, val_s3_path

