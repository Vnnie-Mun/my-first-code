    Type: AWS::Serverless::Function
    Properties:
      FunctionName: !Sub 'ai-mshauri-mentor-${Environment}'
      CodeUri: ./src
      Handler: mshauri_main.lambda_handler
      Runtime: python3.11
      
      # IAM Role with necessary permissions
      Policies:
        - Version: '2012-10-17'
          Statement:
            # Bedrock permissions
            - Effect: Allow
