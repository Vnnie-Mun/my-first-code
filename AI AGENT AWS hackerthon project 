class UserProfileManager:
    """
    Manages user profiles in DynamoDB
    Stores: phone, location, persona, language, interaction history
    """
    
    def __init__(self):
        self.table = dynamodb.Table(CONFIG['DYNAMODB_USERS_TABLE'])
    
    def get_or_create_user(self, phone_number: str) -> Dict:
        """
        Retrieve or create user profile
        
        Args:
            phone_number: User's phone (international format: +254...)
        
        Returns:
            Dictionary with user profile
        """
        try:
            response = self.table.get_item(Key={'phone_number': phone_number})
            
            if 'Item' in response:
                logger.info(f"✅ User profile found: {phone_number}")
                return response['Item']
            else:
                logger.info(f"📝 Creating new user profile: {phone_number}")
                user_profile = {
                    'phone_number': phone_number,
                    'user_id': str(uuid.uuid4()),
                    'created_at': datetime.utcnow().isoformat(),
                    'language': 'sw',  # Default: Swahili
                    'persona': 'farmer',  # Will be updated based on interaction
                    'county': 'unknown',
                    'interaction_count': 0,
                    'last_interaction': datetime.utcnow().isoformat()
                }
                self.table.put_item(Item=user_profile)
                return user_profile
        
        except Exception as e:
            logger.error(f"❌ Error getting/creating user profile: {str(e)}")
            raise
    
    def update_user_profile(self, phone_number: str, updates: Dict) -> Dict:
        """
        Update user profile with new information
        
        Args:
            phone_number: User phone number
            updates: Dictionary of fields to update
        
        Returns:
            Updated user profile
        """
        try:
            response = self.table.update_item(
                Key={'phone_number': phone_number},
                UpdateExpression='SET ' + ', '.join(f'{k}=:{k}' for k in updates.keys()),
                ExpressionAttributeValues={f':{k}': v for k, v in updates.items()},
                ReturnValues='ALL_NEW'
            )
            return response['Attributes']
        except Exception as e:
            logger.error(f"❌ Error updating user profile: {str(e)}")
            raise

