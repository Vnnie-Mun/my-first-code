class ContextEnricher:
    """
    Enriches user context with local data
    Fetches cooperatives, opportunities, and services by county
    """
    
    def __init__(self):
        self.locals_table = dynamodb.Table(CONFIG['DYNAMODB_LOCALS_TABLE'])
        self.context_table = dynamodb.Table(CONFIG['DYNAMODB_CONTEXT_TABLE'])
    
    def get_local_resources(self, county: str, category: str) -> List[Dict]:
        """
        Get local resources by county and category
        
        Args:
            county: County name (e.g., "Kisumu")
            category: Resource type (e.g., "cooperative", "skills_training")
        
        Returns:
            List of relevant local resources
        """
        try:
            response = self.locals_table.query(
                KeyConditionExpression='county = :county AND category_type = :cat',
                ExpressionAttributeValues={
                    ':county': county,
                    ':cat': category
                },
                Limit=5
            )
            return response.get('Items', [])
        except Exception as e:
            logger.error(f"❌ Error fetching local resources: {str(e)}")
            return []
    
    def store_user_context(self, user_id: str, context: Dict) -> bool:
        """
        Store user interaction context for analytics
        
        Args:
            user_id: User ID
            context: Context data
        
        Returns:
            Success boolean
        """
        try:
            context['timestamp'] = datetime.utcnow().isoformat()
            context['user_id'] = user_id
            self.context_table.put_item(Item=context)
            logger.info(f"✅ Context stored for user: {user_id}")
            return True
        except Exception as e:
            logger.error(f"❌ Error storing context: {str(e)}")
            return False

