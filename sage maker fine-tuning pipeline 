class TrainingPipeline:
    """
    End-to-end training pipeline
    """
    
    def __init__(
        self,
        s3_bucket: str,
        role_arn: str,
        region: str = 'us-east-1'
    ):
        self.s3_bucket = s3_bucket
        self.role_arn = role_arn
        self.region = region
        
        self.collector = MshuariDataCollector(s3_bucket)
        self.finetuner = MshuariModelFinetuner(role_arn)
        
        logger.info("🚀 Training Pipeline initialized")
    
    def run(self) -> Dict:
        """
        Run complete training pipeline
        
        Returns:
            Pipeline results
        """
        
        logger.info("=" * 60)
        logger.info("🎯 MSHAURI MODEL TRAINING PIPELINE")
        logger.info("=" * 60)
        
        try:
            # Step 1: Collect data
            logger.info("\n📊 Step 1: Collecting interaction data...")
            interactions_df = self.collector.collect_interactions(days_back=30)
            
            if interactions_df.empty:
                logger.error("❌ No interaction data found")
                return {'status': 'error', 'message': 'No training data'}
            
            # Step 2: Prepare datasets
            logger.info("\n🔄 Step 2: Preparing training datasets...")
            train_examples, val_examples = self.collector.prepare_training_dataset(
                interactions_df
            )
            
            # Step 3: Save to S3
            logger.info("\n💾 Step 3: Saving datasets to S3...")
            train_s3, val_s3 = self.collector.save_training_dataset(
                train_examples,
                val_examples
            )
            
            # Step 4: Fine-tune model
            logger.info("\n🧠 Step 4: Fine-tuning model...")
            model_artifact = self.finetuner.finetune_model(
                train_s3,
                val_s3,
                model_name='mshauri-mentor-model'
            )
            
            # Step 5: Deploy model
            logger.info("\n🚀 Step 5: Deploying model...")
            endpoint_name = self.finetuner.deploy_model(
                model_artifact,
                model_name='mshauri-mentor-endpoint'
            )
            
            # Step 6: Evaluate
            logger.info("\n📊 Step 6: Evaluating model...")
            evaluator = ModelEvaluator(endpoint_name)
            metrics = evaluator.evaluate_on_dataset(val_examples)
            
            # Final status
            result = {
                'status': 'success',
                'timestamp': datetime.utcnow().isoformat(),
                'data': {
                    'training_examples': len(train_examples),
                    'validation_examples': len(val_examples)
                },
                'model': {
                    'artifact_s3': model_artifact,
                    'endpoint_name': endpoint_name
                },
                'metrics': metrics
            }
            
            logger.info("\n" + "=" * 60)
            logger.info("✅ TRAINING PIPELINE COMPLETE")
            logger.info("=" * 60)
            logger.info(f"📊 Endpoint: {endpoint_name}")
            logger.info(f"📈 Accuracy: {metrics['accuracy']:.2%}")
            logger.info(f"⏱️  Latency: {metrics['average_latency_seconds']:.2f}s")
            
            return result
        
        except Exception as e:
            logger.error(f"\n❌ Pipeline failed: {str(e)}")
            return {
                'status': 'error',
                'error': str(e),
                'timestamp': datetime.utcnow().isoformat()
            }

